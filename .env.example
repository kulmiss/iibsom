APP_NAME=iibsom
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8095

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Where the site runs: vps or shared. See docs/hosting-modes.md
HOSTING_MODE=vps

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=iibsom
DB_USERNAME=iibsom
DB_PASSWORD=secret

# VPS: redis. Shared hosting: database (for SESSION_DRIVER, QUEUE_CONNECTION, CACHE_STORE).
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Live site: true (default when APP_ENV=production)
# SESSION_SECURE_COOKIE=true

# Behind Cloudflare or a load balancer: the proxy addresses to trust ("*" = any).
# Leave empty when visitors connect to this server directly.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@iibsom.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google sign-in (see docs/google-signin.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Auto-post new ads (switch "social.autopost", OFF). See docs/social-autopost.md. Keep empty to not use.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# Ad photos: public (your PC) or r2 (live). See docs/cloudflare-r2.md for R2 keys.
PHOTOS_DISK=public
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
