#!/usr/bin/env bash
# Lighthouse (phone settings) on the main pages. Needs a running site with demo data.
#   bash tools/lighthouse [base-url]     default http://localhost:8095
# Fails when a score is under the limits in lighthouserc.json.
# ("is-crawlable" is skipped: only the live site may be indexed by Google.)
set -euo pipefail
base="${1:-http://localhost:8095}"
ad=$(curl -sf "$base/cars" | grep -o "href=\"$base/cars/[a-z0-9-]*/[a-z0-9-]*-[0-9]*\"" | head -1 | cut -d'"' -f2 || true)
urls=("$base/" "$base/cars" "$base/search?q=toyota" "$base/safety" "$base/help/post-an-ad")
[ -n "$ad" ] && urls+=("$ad")
brand=$(curl -sf "$base/cars/mogadishu" | grep -o "href=\"$base/cars/mogadishu/[a-z-]*\"" | head -1 | cut -d'"' -f2 || true)
[ -n "$brand" ] && urls+=("$brand")
# Somali pages too, when Somali is ON (the language switch only shows then).
[ "$(curl -s -o /dev/null -w '%{http_code}' "$base/so")" = "200" ] && urls+=("$base/so")
args=()
for u in "${urls[@]}"; do args+=(--collect.url="$u"); done
npx --yes @lhci/cli@0.14 autorun --config=lighthouserc.json "${args[@]}"
