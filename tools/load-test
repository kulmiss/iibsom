#!/usr/bin/env python3
"""Load test (docs/load-test.md): per-page timings and a mixed run with many users at once.

Usage (with the *_load database in your environment, see the doc):
  tools/load-test pages                 # each page 15 times, one after another
  tools/load-test mix 20 30             # 20 users at once for 30 seconds
Address: LOAD_URL (default http://127.0.0.1:8096)."""
import os, sys, time, json, random, statistics, subprocess, threading, urllib.request, urllib.error
from concurrent.futures import ThreadPoolExecutor
B=os.environ.get('LOAD_URL','http://127.0.0.1:8096')
ROOT=os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
def tinker(code): return subprocess.run(['php','artisan','tinker','--execute='+code],cwd=ROOT,capture_output=True,text=True).stdout.strip()
ids=json.loads(tinker('echo json_encode(App\\Models\\Ad::where("status","live")->inRandomOrder()->limit(300)->get()->map(fn($a)=>parse_url($a->url(),PHP_URL_PATH))->all());').splitlines()[-1])
opener=urllib.request.build_opener(urllib.request.ProxyHandler({}))
def get(path, headers=None):
    t=time.perf_counter()
    try:
        r=opener.open(urllib.request.Request(B+path, headers=headers or {}), timeout=60); r.read(); code=r.status
    except urllib.error.HTTPError as e: code=e.code
    except Exception as e: code=0
    return code, (time.perf_counter()-t)*1000
pages=[('home','/'),('category (cars)','/cars'),('category (phones)','/mobile-phones'),('main category','/vehicles'),
       ('search "toyota"','/search?q=toyota'),('search cheapest','/search?q=iphone&sort=cheapest'),('price filter','/cars?min=5000&max=8000'),
       ('brand page','/cars/mogadishu/toyota'),
       ('filters: 7 days+photos','/cars?posted=7d&photos=1'),('filters: popular','/vehicles?sort=popular'),
       ('filters: many','/cars?min=1000&max=20000&condition=used&posted=30d&photos=1&sort=cheapest'),
       ('filter count (JSON)','/browse-count?category=cars&min=1000&max=20000&posted=30d&photos=1'),('ad page','AD'),('page 50 of a list','/mobile-phones?page=50'),
       ('API list','/api/v1/ads'),('API search','/api/v1/ads?q=samsung&category=mobile-phones'),('API ad','APIAD'),('sitemap','/sitemap.xml')]
def path_for(p):
    if p=='AD': return random.choice(ids)
    if p=='APIAD': return '/api/v1/ads/'+random.choice(ids).rsplit('-',1)[1]
    return p
mode=sys.argv[1] if len(sys.argv)>1 else 'all'
results={}
if mode in ('all','pages'):
    print(f"{'page':22} {'median ms':>10} {'p95 ms':>8} {'codes'}")
    for name,p in pages:
        get(path_for(p)) # warm
        times=[];codes=set()
        for _ in range(15):
            c,ms=get(path_for(p)); times.append(ms); codes.add(c)
        times.sort(); med=statistics.median(times); p95=times[int(len(times)*0.95)-1]
        results[name]=(med,p95,codes)
        print(f"{name:22} {med:10.0f} {p95:8.0f} {sorted(codes)}")
if mode in ('all','mix'):
    users=int(sys.argv[2]) if len(sys.argv)>2 else 8; seconds=int(sys.argv[3]) if len(sys.argv)>3 else 30
    weights=[('/',3),('/cars',2),('/mobile-phones',2),('/search?q=toyota',2),('AD',6),('/api/v1/ads',1),('/cars/mogadishu/toyota',1)]
    bag=[p for p,w in weights for _ in range(w)]
    stop=time.time()+seconds; lat=[]; codes={}; lock=threading.Lock()
    def worker():
        while time.time()<stop:
            c,ms=get(path_for(random.choice(bag)))
            with lock: lat.append(ms); codes[c]=codes.get(c,0)+1
    with ThreadPoolExecutor(users) as ex:
        for _ in range(users): ex.submit(worker)
    lat.sort()
    print(f"\nMIX {users} users x {seconds}s: {len(lat)} requests, {len(lat)/seconds:.1f}/s, median {statistics.median(lat):.0f} ms, p95 {lat[int(len(lat)*0.95)]:.0f} ms, p99 {lat[int(len(lat)*0.99)]:.0f} ms, codes {codes}")
